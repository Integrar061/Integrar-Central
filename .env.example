# Copie este arquivo para a raiz do projeto como `.env` e preencha:

# Google OAuth 2.0 (Google Calendar API + Google Identity Services)
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# Supabase - Persistência do Banco de Dados
# Encontre em: Project Settings -> API no painel do Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-anon-public-key
# Ou use a service role key se necessário:
VITE_SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

