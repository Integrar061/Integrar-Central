# Copie este arquivo para a raiz do projeto como `.env` e preencha:

# Client ID OAuth 2.0 (tipo "Aplicativo da Web") no Google Cloud Console
# APIs necessárias: Google Calendar API + Google Identity Services
# Origens JavaScript autorizadas (exemplo local): http://localhost:3000
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
